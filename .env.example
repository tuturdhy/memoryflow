# ============================================================
# REQUIRED - Must be set before running
# ============================================================

# CockroachDB Connection String
# Get from: https://cockroachlabs.cloud
DATABASE_URL=postgresql://user:password@host:26257/memoryflow?sslmode=require

# Groq API Key for LLM
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ============================================================
# OPTIONAL - Defaults are provided if not set
# ============================================================

# Groq Model to use
# Current: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-random-32-char-string-here

# Environment
NODE_ENV=development